+<label>用户名<input name="username" maxlength="256" disabled placeholder="留空则由客户端输入"></label>
+<label>域<input name="domain" maxlength="256" disabled placeholder="例如 CONTOSO"></label>
+<label>提示输入凭据<select name="prompt_credentials"><option value="">沿用服务器设置</option><option value="1">是</option><option value="0">否</option></select></label>
+<label>显示模式<select name="fullscreen"><option value="">沿用服务器设置</option><option value="1">全屏</option><option value="0">窗口</option></select></label>
+<label>多显示器<select name="multimon"><option value="">沿用服务器设置</option><option value="1">启用</option><option value="0">关闭</option></select></label>
+<label>窗口宽度<input name="width" type="number" min="200" max="8192" placeholder="沿用服务器设置"></label>
+<label>窗口高度<input name="height" type="number" min="200" max="8192" placeholder="沿用服务器设置"></label>
+<label>音频播放<select name="audiomode"><option value="">沿用服务器设置</option><option value="0">本地播放</option><option value="1">远程播放</option><option value="2">关闭</option></select></label>
+<label>剪贴板<select name="clipboard"><option value="">沿用服务器设置</option>{{if .Caps.Clipboard}}<option value="1">启用</option>{{end}}<option value="0">关闭</option></select></label>
+<label>磁盘重定向<select name="drives"><option value="">沿用服务器设置</option>{{if .Caps.Drive}}<option value="1">启用全部本地磁盘</option>{{end}}<option value="0">关闭</option></select></label>
+<label>打印机<select name="printers"><option value="">沿用服务器设置</option>{{if .Caps.Printer}}<option value="1">启用</option>{{end}}<option value="0">关闭</option></select></label>
+</form><p class="hint">自定义桌面账户只用于桌面登录；网关继续使用你的 OIDC 登录身份。网关策略禁用的重定向无法在此启用。</p>
+<button type="button" id="reset">重置选项</button></details>
+<p id="session-expired" class="notice hidden" role="alert">登录已过期，<a href="/">重新登录</a>后再连接。</p>
+<noscript><p>高级选项与自动刷新需要 JavaScript；连接按钮仍可使用服务器默认设置。刷新浏览器页面可更新状态。</p></noscript>
+</main>
+<script nonce="{{.Nonce}}">
+(()=>{
+ const options=document.getElementById('options'),mode=document.getElementById('credential-mode');
+ function accountFields(){for(const name of ['username','domain']) options.elements.namedItem(name).disabled=mode.value!=='custom'}
+ mode.addEventListener('change',accountFields);
+ document.getElementById('reset').addEventListener('click',()=>{options.reset();accountFields()});
+ for(const form of document.querySelectorAll('.connect-form')) form.addEventListener('submit',event=>{
+  if(!options.reportValidity()){event.preventDefault();return}
+  for(const node of form.querySelectorAll('[data-option]'))node.remove();
+  for(const [name,value] of new FormData(options)){
+   if(value===''&&name!=='username'&&name!=='domain')continue;
+   const field=document.createElement('input');field.type='hidden';field.name=name;field.value=value;field.dataset.option='1';form.append(field);
+  }
+ });
+ function localTimes(root){for(const node of root.querySelectorAll('time[datetime]'))node.textContent=new Date(node.dateTime).toLocaleTimeString()}
+ localTimes(document);
+ let busy=false,expired=false;
+ const refresh=document.getElementById('refresh'),message=document.getElementById('refresh-message');
+ async function update(){
+  if(busy||expired||document.hidden)return;
+  busy=true;refresh.disabled=true;message.textContent='正在检测 RDP 端口…';
+  try{
+   const response=await fetch('/',{credentials:'same-origin',cache:'no-store',redirect:'manual',headers:{'X-Landing-Refresh':'1'}});
+   if(response.status===401||response.type==='opaqueredirect'){
+    expired=true;document.getElementById('session-expired').classList.remove('hidden');
+    for(const button of document.querySelectorAll('.connect-form button'))button.disabled=true;
+    message.textContent='状态更新已暂停';return;
+   }
+   if(!response.ok)throw new Error('status');
+   // Parse into an inert template: refreshed styles carry a different CSP nonce.
+   const fragment=document.createElement('template');fragment.innerHTML=await response.text();
+   const page=fragment.content;
+   if(!page.querySelector('#machines'))throw new Error('page');
+   for(const row of document.querySelectorAll('[data-machine]')){
+    const incoming=page.querySelector('[data-machine="'+row.dataset.machine+'"] .status-region');
+    if(incoming)row.querySelector('.status-region').replaceWith(incoming);
+   }
+   localTimes(document);message.textContent='状态已更新 · 每 15 秒检查';
+  }catch(error){message.textContent='状态刷新失败，保留上次结果。可稍后重试。'}
+  finally{busy=false;refresh.disabled=expired}
+ }
+ refresh.addEventListener('click',update);
+ setInterval(update,15000);document.addEventListener('visibilitychange',()=>{if(!document.hidden)update()});
+})();
+</script></body></html>
