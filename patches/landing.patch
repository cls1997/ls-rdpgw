+
+func TestConnectOverrides(t *testing.T) {
+	h := landingHandler()
+	h.rdpOpts = RdpOpts{UsernameTemplate: "{{ username }}\x1f{{ token }}", SplitUserDomain: true}
+	h.enableUserToken = true
+	h.userTokenGenerator = func(ctx context.Context, user string) (string, error) {
+		t.Fatal("custom desktop account generated user token")
+		return "", nil
