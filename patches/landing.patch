+
+func authenticatedRequest(method, path string) *http.Request {
+	req := httptest.NewRequest(method, path, nil)
+	id := identity.NewUser()
+	id.SetUserName("oidc-user@example.com")
+	id.SetAuthenticated(true)
+	return identity.AddToRequestCtx(id, req)
