font-size:13px}input,select{width:100%;margin-top:6px;background:var(--bg);color:#edf3fa;border:1px solid var(--line);border-radius:6px;padding:10px;font:inherit}input:disabled{opacity:.45}.hint{font-size:12px}.notice{color:#ffbe89}.hidden{display:none}@media(max-width:680px){main{padding:28px 16px}header{flex-direction:column}.machine{grid-template-columns:1fr auto;gap:12px;padding:16px}.machine form{grid-column:1/-1}.machine button{width:100%}.options{grid-template-columns:1fr}h1{font-size:28px}.toolbar{align-items:start}}
+</style>
+</head>
+<body><main>
+<header><div><div class="brand">RDPGW / REMOTE ACCESS</div><h1>你的远程桌面</h1><p>选择一台机器，下载连接文件并用本地远程桌面客户端打开。</p></div><div class="account">{{.User}}</div></header>
+<div class="toolbar"><div><strong>机器列表</strong><p class="hint">在线表示网关可访问 RDP 端口。不可达时仍可尝试连接。</p></div><button id="refresh" type="button">刷新状态</button></div>
+<p id="refresh-message" role="status" aria-live="polite" class="hint">每 15 秒更新状态</p>
+{{if .Signed}}<p class="notice">当前使用 signed 选机模式，请使用已有的签名连接链接；此页面暂不提供直接选机连接。</p>{{end}}
