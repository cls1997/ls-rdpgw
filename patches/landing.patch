+
+	"github.com/bolkedebruin/rdpgw/cmd/rdpgw/identity"
+	"github.com/coreos/go-oidc/v3/oidc"
+	"github.com/go-jose/go-jose/v3"
+	"github.com/go-jose/go-jose/v3/jwt"
+	"golang.org/x/oauth2"
+)
+
+func TestOIDCCallbackPreservesConnectOptions(t *testing.T) {
+	key, err := rsa.GenerateKey(rand.Reader, 2048)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var issuer string
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		switch r.URL.Path {
+		case "/.well-known/openid-configuration":
+			json.NewEncoder(w).Encode(map[string]interface{}{"issuer": issuer, "authorization_endpoint": issuer + "/auth", "token_endpoint": issuer + "/token", "jwks_uri": issuer + "/keys", "id_token_signing_alg_values_supported": []string{"RS256"}})
+		case "/keys":
+			json.NewEncoder(w).Encode(jose.JSONWebKeySet{Keys: []jose.JSONWebKey{{Key: &key.PublicKey, KeyID: "test", Algorithm: "RS256", Use: "sig"}}})
+		case "/token":
+			signer, err := jose.NewSigner(jose.SigningKey{Algorithm: jose.RS256, Key: key}, (&jose.SignerOptions{}).WithHeader("kid", "test"))
+			if err != nil {
+				http.Error(w, err.Error(), 500)
+				return
+			}
+			token, err := jwt.Signed(signer).Claims(jwt.Claims{Issuer: issuer, Subject: "opaque-subject", Audience: jwt.Audience{"test-client"}, Expiry: jwt.NewNumericDate(time.Now().Add(time.Minute)), IssuedAt: jwt.NewNumericDate(time.Now())}).Claims(map[string]interface{}{"preferred_username": "oidc-user"}).CompactSerialize()
+			if err != nil {
+				http.Error(w, err.Error(), 500)
+				return
+			}
+			json.NewEncoder(w).Encode(map[string]interface{}{"access_token": "test-access", "token_type": "Bearer", "id_token": token, "expires_in": 60})
+		default:
+			http.NotFound(w, r)
+		}
+	}))
+	defer server.Close()
+	issuer = server.URL
+	provider, err := oidc.NewProvider(context.Background(), issuer)
+	if err != nil {
+		t.Fatal(err)
+	}
+	o := (&OIDCConfig{OAuth2Config: &oauth2.Config{ClientID: "test-client", ClientSecret: "test-secret", RedirectURL: "https://gateway.example/callback", Endpoint: provider.Endpoint()}, OIDCTokenVerifier: provider.Verifier(&oidc.Config{ClientID: "test-client"})}).New()
+	InitStore([]byte("01234567890123456789012345678901"), []byte("01234567890123456789012345678901"), "cookie", 0)
+	original := "/connect?host=desktop%3A3390&credential_mode=custom&username=desktop-user&domain=CONTOSO&clipboard=0"
+	start := identity.AddToRequestCtx(identity.NewUser(), httptest.NewRequest("GET", original, nil))
+	redirect := httptest.NewRecorder()
+	o.Authenticated(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { t.Fatal("unauthenticated connect") })).ServeHTTP(redirect, start)
+	authURL, _ := url.Parse(redirect.Header().Get("Location"))
+	callback := identity.AddToRequestCtx(identity.NewUser(), httptest.NewRequest("GET", "/callback?code=test-code&state="+authURL.Query().Get("state"), nil))
+	rr := httptest.NewRecorder()
+	o.HandleCallback(rr, callback)
+	if rr.Code != 302 || rr.Header().Get("Location") != original {
+		t.Fatal(rr.Code, rr.Header(), rr.Body.String())
+	}
+	request := httptest.NewRequest("GET", rr.Header().Get("Location"), nil)
+	for _, cookie := range rr.Result().Cookies() {
+		request.AddCookie(cookie)
+	}
+	download := httptest.NewRecorder()
+	h := landingHandler()
+	EnrichContext(o.Authenticated(http.HandlerFunc(h.HandleDownload))).ServeHTTP(download, request)
+	if download.Code != 200 {
+		t.Fatal(download.Code, download.Body.String())
+	}
+	data := rdpToMap(strings.Split(download.Body.String(), "\r\n"))
+	if data["username"] != "desktop-user" || data["domain"] != "CONTOSO" || data["gatewayaccesstoken"] != "oidc-user_desktop:3390" || data["redirectclipboard"] != "0" {
+		t.Fatal(data)
+	}
+}
