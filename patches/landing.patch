+func TestLandingAuthenticationAndRendering(t *testing.T) {
+	h := landingHandler()
+	h.hosts = []string{"desktop:3390", "my-{{ preferred_username }}-host:3391", "invalid:0"}
+	var addresses []string
+	var mu sync.Mutex
+	h.probes.dial = func(ctx context.Context, network, address string) (net.Conn, error) {
+		mu.Lock()
+		addresses = append(addresses, address)
+		mu.Unlock()
+		if strings.HasPrefix(address, "desktop:") {
+			a, b := net.Pipe()
+			b.Close()
+			return a, nil
+		}
+		return nil, errors.New("unreachable")
+	}
+	rr := httptest.NewRecorder()
+	h.HandleLanding(rr, httptest.NewRequest("GET", "/", nil))
+	if rr.Code != 401 {
+		t.Fatal(rr.Code)
+	}
+	req := authenticatedRequest("GET", "/")
+	identity.FromRequestCtx(req).SetUserName("alice")
+	rr = httptest.NewRecorder()
+	h.HandleLanding(rr, req)
+	if rr.Code != 200 {
+		t.Fatal(rr.Code, rr.Body.String())
+	}
