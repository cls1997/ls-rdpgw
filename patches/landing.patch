+func TestProbeCacheAndPort(t *testing.T) {
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+	go func() {
+		conn, err := listener.Accept()
+		if err == nil {
+			conn.Close()
+		}
+	}()
+	p := newProbeCache()
+	result := p.check(context.Background(), listener.Addr().String())
+	if !result.Online {
+		t.Fatal("explicit port not probed")
+	}
+	listener.Close()
+	if cached := p.check(context.Background(), listener.Addr().String()); cached != result {
+		t.Fatal("cache miss")
+	}
+	p.mu.Lock()
+	p.results[listener.Addr().String()] = probeResult{Checked: time.Now().Add(-probeTTL)}
+	p.mu.Unlock()
+	if p.check(context.Background(), listener.Addr().String()).Online {
+		t.Fatal("stale cache used")
+	}
+}
+
+func TestProbeConcurrencyAndSingleFlight(t *testing.T) {
+	p := newProbeCache()
+	var calls, active, maxActive atomic.Int32
+	p.dial = func(ctx context.Context, network, address string) (net.Conn, error) {
+		calls.Add(1)
+		n := active.Add(1)
+		defer active.Add(-1)
+		for {
+			old := maxActive.Load()
+			if n <= old || maxActive.CompareAndSwap(old, n) {
+				break
+			}
+		}
+		time.Sleep(15 * time.Millisecond)
+		return nil, errors.New("offline")
+	}
+	var wg sync.WaitGroup
+	for i := 0; i < 20; i++ {
+		wg.Add(1)
+		go func() { defer wg.Done(); p.check(context.Background(), "same:3389") }()
+	}
+	wg.Wait()
+	if calls.Load() != 1 {
+		t.Fatal("duplicate probes", calls.Load())
+	}
+	calls.Store(0)
+	for i := 0; i < 24; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			p.check(context.Background(), net.JoinHostPort("host", strconv.Itoa(3300+i)))
+		}(i)
+	}
+	wg.Wait()
+	if maxActive.Load() > 8 {
+		t.Fatal("concurrency limit", maxActive.Load())
+	}
+}
+
+func TestProbeTimeoutCancellationAndIsolation(t *testing.T) {
+	p := newProbeCache()
+	p.dial = func(ctx context.Context, network, address string) (net.Conn, error) {
+		deadline, ok := ctx.Deadline()
+		if !ok || time.Until(deadline) > probeTimeout {
+			t.Error("missing dial timeout")
+		}
+		if address == "my-alice:3389" {
+			a, b := net.Pipe()
+			b.Close()
+			return a, nil
+		}
+		<-ctx.Done()
+		return nil, ctx.Err()
+	}
+	if !p.check(context.Background(), "my-alice:3389").Online {
+		t.Fatal("alice offline")
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Millisecond)
+	defer cancel()
+	if p.check(ctx, "my-bob:3389").Online {
+		t.Fatal("user cache leaked")
+	}
+	p.mu.Lock()
+	_, cached := p.results["my-bob:3389"]
+	p.mu.Unlock()
+	if cached {
+		t.Fatal("canceled probe cached")
+	}
+}
+
+func TestOIDCReturnURLAndRefreshExpiry(t *testing.T) {
+	o := (&OIDCConfig{OAuth2Config: &oauth2.Config{ClientID: "client", Endpoint: oauth2.Endpoint{AuthURL: "https://idp.example/auth"}}}).New()
+	req := httptest.NewRequest("GET", "/connect?host=desktop%3A3390&credential_mode=custom&username=desktop-user&domain=CONTOSO", nil)
+	req = identity.AddToRequestCtx(identity.NewUser(), req)
+	rr := httptest.NewRecorder()
+	handler := o.Authenticated(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { t.Fatal("unauthenticated") }))
+	handler.ServeHTTP(rr, req)
+	location, err := url.Parse(rr.Header().Get("Location"))
+	if err != nil || rr.Code != 302 {
+		t.Fatal(rr.Code, err)
+	}
+	stored, ok := o.stateStore.Get(location.Query().Get("state"))
+	if !ok || stored != req.RequestURI {
+		t.Fatal("return URL lost", stored)
+	}
+	req = identity.AddToRequestCtx(identity.NewUser(), httptest.NewRequest("GET", "/", nil))
+	req.Header.Set("X-Landing-Refresh", "1")
+	rr = httptest.NewRecorder()
+	handler.ServeHTTP(rr, req)
+	if rr.Code != 401 || rr.Header().Get("Location") != "" {
+		t.Fatal("refresh redirected", rr.Code)
+	}
+}
