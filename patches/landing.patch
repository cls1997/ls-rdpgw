+package target
+
+import "testing"
+
+func TestAddress(t *testing.T) {
+	cases := map[string]string{"desktop": "desktop:3389", "desktop:3390": "desktop:3390", "10.0.0.1": "10.0.0.1:3389", "10.0.0.1:3391": "10.0.0.1:3391", "::1": "[::1]:3389", "[::1]": "[::1]:3389", "[::1]:3390": "[::1]:3390", "[0:0:0:0:0:0:0:1]:3390": "[::1]:3390"}
+	for input, expected := range cases {
+		t.Run(input, func(t *testing.T) {
+			got, err := Address(input)
+			if err != nil || got != expected {
+				t.Fatalf("got %q, %v; want %q", got, err, expected)
+			}
+		})
+	}
+	for _, input := range []string{"", ":3389", "desktop:", "desktop:0", "desktop:65536", "desktop:rdp", "bad:host:3389", "https://desktop", "host\r\n", "user@host", "{{ preferred_username }}:3389", "[::1", "host name"} {
+		if got, err := Address(input); err == nil {
+			t.Errorf("accepted %q as %q", input, got)
+		}
+	}
+}
