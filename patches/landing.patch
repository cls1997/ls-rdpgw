diff --git a/cmd/rdpgw/security/landing_test.go b/cmd/rdpgw/security/landing_test.go
new file mode 100644
--- /dev/null
+++ b/cmd/rdpgw/security/landing_test.go
@@ -0,0 +1,65 @@
+package security
+
+import (
+	"context"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/bolkedebruin/rdpgw/cmd/rdpgw/identity"
+	"github.com/bolkedebruin/rdpgw/cmd/rdpgw/protocol"
+	"github.com/go-jose/go-jose/v3/jwt"
+)
+
+func TestLandingTargetPolicy(t *testing.T) {
+	oldHosts, oldSelection, oldIP := Hosts, HostSelection, VerifyClientIP
+	defer func() { Hosts, HostSelection, VerifyClientIP = oldHosts, oldSelection, oldIP }()
+	Hosts = []string{"desktop", "my-{{ preferred_username }}-host:3390", "[::1]"}
+	HostSelection = "roundrobin"
+	VerifyClientIP = false
+	tunnel := protocol.Tunnel{TargetServer: "desktop", User: identity.NewUser()}
+	tunnel.User.SetUserName("alice")
+	ctx := context.WithValue(context.Background(), protocol.CtxTunnel, &tunnel)
+	for _, host := range []string{"desktop:3389", "my-alice-host:3390", "[::1]:3389"} {
+		if ok, err := CheckHost(ctx, host); !ok || err != nil {
+			t.Errorf("allowed %s: %v %v", host, ok, err)
+		}
+	}
+	for _, host := range []string{"desktop:3390", "my-bob-host:3390"} {
+		if ok, _ := CheckHost(ctx, host); ok {
+			t.Errorf("accepted %s", host)
+		}
+	}
+	if ok, err := CheckSession(CheckHost)(ctx, "desktop:3389"); !ok || err != nil {
+		t.Fatal("default port session mismatch", ok, err)
+	}
+	if ok, _ := CheckSession(CheckHost)(ctx, "desktop:3390"); ok {
+		t.Fatal("accepted different port")
+	}
+}
+
+func TestPAATokenBindsHostTemplateIdentity(t *testing.T) {
+	oldSigning := SigningKey
+	defer func() { SigningKey = oldSigning }()
+	SigningKey = []byte("01234567890123456789012345678901")
+	id := identity.NewUser()
+	id.SetUserName("alice@example.com")
+	id.SetAttribute(identity.AttrClientIp, "127.0.0.1")
+	id.SetAttribute(identity.AttrAccessToken, "test-access")
+	req := identity.AddToRequestCtx(id, httptest.NewRequest("GET", "/connect", nil))
+	raw, err := GeneratePAAToken(req.Context(), "alice", "my-alice@example.com-host:3389")
+	if err != nil {
+		t.Fatal(err)
+	}
+	parsed, err := jwt.ParseSigned(raw)
+	if err != nil {
+		t.Fatal(err)
+	}
+	standard := jwt.Claims{}
+	custom := customClaims{}
+	if err := parsed.Claims(SigningKey, &standard, &custom); err != nil {
+		t.Fatal(err)
+	}
+	if standard.Subject != "alice" || custom.HostUserName != "alice@example.com" {
+		t.Fatal("gateway identity not preserved", standard, custom)
+	}
+}
diff --git a/cmd/rdpgw/target/target.go b/cmd/rdpgw/target/target.go
new file mode 100644
--- /dev/null
+++ b/cmd/rdpgw/target/target.go
@@ -0,0 +1,46 @@
+// Package target keeps RDP file, policy and reachability addresses consistent.
+package target
+
+import (
+	"fmt"
+	"net"
+	"strconv"
+	"strings"
+	"unicode"
+)
+
+func Address(value string) (string, error) {
+	for _, ch := range value {
+		if unicode.IsSpace(ch) || unicode.IsControl(ch) {
+			return "", fmt.Errorf("invalid target address")
+		}
+	}
+	host, port, err := net.SplitHostPort(value)
+	if err != nil {
+		switch {
+		case net.ParseIP(value) != nil:
+			host = value
+		case strings.HasPrefix(value, "[") && strings.HasSuffix(value, "]") && net.ParseIP(value[1:len(value)-1]) != nil:
+			host = value[1 : len(value)-1]
+		case !strings.ContainsAny(value, ":[]"):
+			host = value
+		default:
+			return "", fmt.Errorf("invalid target address")
+		}
+		port = "3389"
+	}
+	if host == "" || strings.ContainsAny(host, "/\\?#@{}") {
+		return "", fmt.Errorf("invalid target host")
+	}
+	n, err := strconv.Atoi(port)
+	if err != nil || n < 1 || n > 65535 {
+		return "", fmt.Errorf("invalid target port")
+	}
+	if strings.Contains(host, ":") && net.ParseIP(host) == nil {
+		return "", fmt.Errorf("invalid IPv6 target")
+	}
+	if ip := net.ParseIP(host); ip != nil {
+		host = ip.String()
+	}
+	return net.JoinHostPort(host, strconv.Itoa(n)), nil
+}
