diff --git a/cmd/rdpgw/web/landing.go b/cmd/rdpgw/web/landing.go
new file mode 100644
--- /dev/null
+++ b/cmd/rdpgw/web/landing.go
@@ -0,0 +1,159 @@
+package web
+
+import (
+	"context"
+	"crypto/rand"
+	_ "embed"
+	"encoding/base64"
+	"html/template"
+	"net"
+	"net/http"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/bolkedebruin/rdpgw/cmd/rdpgw/identity"
+	"github.com/bolkedebruin/rdpgw/cmd/rdpgw/target"
+)
+
+const probeTTL = 15 * time.Second
+const probeTimeout = 2 * time.Second
+
+//go:embed landing.html
+var landingHTML string
+var landingTemplate = template.Must(template.New("landing").Parse(landingHTML))
+
+type probeResult struct {
+	Online  bool
+	Checked time.Time
+}
+type probeFlight struct {
+	done   chan struct{}
+	result probeResult
+}
+type probeCache struct {
+	mu      sync.Mutex
+	results map[string]probeResult
+	flights map[string]*probeFlight
+	slots   chan struct{}
+	dial    func(context.Context, string, string) (net.Conn, error)
+}
+
+func newProbeCache() *probeCache {
+	d := &net.Dialer{}
+	return &probeCache{results: make(map[string]probeResult), flights: make(map[string]*probeFlight), slots: make(chan struct{}, 8), dial: d.DialContext}
+}
+
+func (p *probeCache) check(ctx context.Context, address string) probeResult {
+	p.mu.Lock()
+	if result, ok := p.results[address]; ok && time.Since(result.Checked) < probeTTL {
+		p.mu.Unlock()
+		return result
+	}
+	if flight, ok := p.flights[address]; ok {
+		p.mu.Unlock()
+		select {
+		case <-flight.done:
+			return flight.result
+		case <-ctx.Done():
+			return probeResult{}
+		}
+	}
+	// Remove expired per-user targets so the cache cannot grow indefinitely.
+	for key, result := range p.results {
+		if time.Since(result.Checked) >= probeTTL {
+			delete(p.results, key)
+		}
+	}
+	flight := &probeFlight{done: make(chan struct{})}
+	p.flights[address] = flight
+	p.mu.Unlock()
+
+	result := probeResult{}
+	select {
+	case p.slots <- struct{}{}:
+		dialCtx, cancel := context.WithTimeout(ctx, probeTimeout)
+		conn, err := p.dial(dialCtx, "tcp", address)
+		cancel()
+		result = probeResult{Online: err == nil, Checked: time.Now()}
+		if conn != nil {
+			conn.Close()
+		}
+		<-p.slots
+	case <-ctx.Done():
+	}
+	p.mu.Lock()
+	flight.result = result
+	if ctx.Err() == nil && !result.Checked.IsZero() {
+		p.results[address] = result
+	}
+	delete(p.flights, address)
+	close(flight.done)
+	p.mu.Unlock()
+	return result
+}
+
+type landingHost struct {
+	Index                          int
+	Host, Address, Status, Checked string
+	Valid                          bool
+}
+type landingData struct {
+	User, Nonce string
+	Signed      bool
+	Caps        RedirectCaps
+	Hosts       []landingHost
+}
+
+func (h *Handler) HandleLanding(w http.ResponseWriter, r *http.Request) {
+	id := identity.FromRequestCtx(r)
+	if id == nil || !id.Authenticated() {
+		http.Error(w, "Unauthorized", http.StatusUnauthorized)
+		return
+	}
+	nonce := make([]byte, 18)
+	if _, err := rand.Read(nonce); err != nil {
+		http.Error(w, "Unable to render page", http.StatusInternalServerError)
+		return
+	}
+	data := landingData{User: id.UserName(), Nonce: base64.StdEncoding.EncodeToString(nonce), Signed: h.hostSelection == "signed", Caps: h.redirectCaps}
+	data.Hosts = make([]landingHost, len(h.hosts))
+	// A fixed worker pool bounds goroutines as well as network connections.
+	var workers sync.WaitGroup
+	jobs := make(chan int)
+	for n := 0; n < 8; n++ {
+		workers.Add(1)
+		go func() {
+			defer workers.Done()
+			for i := range jobs {
+				raw := h.hosts[i]
+				entry := landingHost{Index: i, Host: raw, Address: strings.ReplaceAll(raw, "{{ preferred_username }}", id.UserName()), Status: "配置无效"}
+				address, err := target.Address(entry.Address)
+				if err == nil {
+					entry.Valid, entry.Address = true, address
+					result := h.probes.check(r.Context(), address)
+					entry.Status = "不可达"
+					if result.Online {
+						entry.Status = "在线"
+					}
+					if !result.Checked.IsZero() {
+						entry.Checked = result.Checked.UTC().Format(time.RFC3339)
+					}
+				}
+				data.Hosts[i] = entry
+			}
+		}()
+	}
+	for i := range h.hosts {
+		jobs <- i
+	}
+	close(jobs)
+	workers.Wait()
+	w.Header().Set("Content-Type", "text/html; charset=utf-8")
+	w.Header().Set("Cache-Control", "no-store")
+	w.Header().Set("X-Content-Type-Options", "nosniff")
+	w.Header().Set("Content-Security-Policy", "default-src 'self'; script-src 'nonce-"+data.Nonce+"'; style-src 'nonce-"+data.Nonce+"'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'")
+	if err := landingTemplate.Execute(w, data); err != nil {
+		return
+	}
+}
