+package web
+
+import (
+	"fmt"
+	"net/url"
+	"strconv"
+	"unicode"
+
+	"github.com/bolkedebruin/rdpgw/cmd/rdpgw/rdp"
+)
+
+// RedirectCaps limits overrides to the capabilities advertised by the gateway.
+type RedirectCaps struct{ Clipboard, Drive, Printer bool }
+
+type connectOptions struct {
+	custom           bool
+	username, domain string
+	values           map[string]int
+}
+
+func parseConnectOptions(q url.Values) (connectOptions, error) {
+	o := connectOptions{values: make(map[string]int)}
+	keys := []string{"credential_mode", "username", "domain", "prompt_credentials", "fullscreen", "width", "height", "multimon", "clipboard", "drives", "printers", "audiomode"}
+	for _, key := range keys {
+		if v, ok := q[key]; ok && len(v) != 1 {
+			return o, fmt.Errorf("duplicate parameter: %s", key)
+		}
+	}
+	mode := q.Get("credential_mode")
+	if mode != "" && mode != "default" && mode != "custom" {
+		return o, fmt.Errorf("invalid credential_mode")
+	}
+	o.custom = mode == "custom"
+	for _, key := range []string{"username", "domain"} {
+		v, present := q[key]
+		if !present {
+			continue
+		}
+		if !o.custom {
+			return o, fmt.Errorf("%s requires credential_mode=custom", key)
+		}
+		if len(v[0]) > 256 {
+			return o, fmt.Errorf("%s is too long", key)
+		}
+		for _, ch := range v[0] {
+			if unicode.IsControl(ch) {
+				return o, fmt.Errorf("invalid %s", key)
+			}
+		}
+	}
+	o.username, o.domain = q.Get("username"), q.Get("domain")
+	for _, key := range keys[3:] {
+		values, present := q[key]
+		if !present {
+			continue
+		}
+		v, err := strconv.Atoi(values[0])
+		if err != nil {
+			return o, fmt.Errorf("invalid %s", key)
+		}
+		low, high := 0, 1
+		if key == "width" || key == "height" {
+			low, high = 200, 8192
+		}
+		if key == "audiomode" {
+			high = 2
+		}
+		if v < low || v > high || strconv.Itoa(v) != values[0] {
+			return o, fmt.Errorf("invalid %s", key)
+		}
+		o.values[key] = v
+	}
+	return o, nil
+}
+
+func (o connectOptions) apply(d *rdp.Builder, caps RedirectCaps) error {
+	for key, allowed := range map[string]bool{"clipboard": caps.Clipboard, "drives": caps.Drive, "printers": caps.Printer} {
+		if v, ok := o.values[key]; ok && v == 1 && !allowed {
+			return fmt.Errorf("%s is disabled by gateway policy", key)
+		}
+	}
+	if o.custom {
+		d.Settings.Username, d.Settings.Domain = o.username, o.domain
+		d.MarkExplicit("Username", "Domain")
+		// Desktop and gateway credentials must be requested independently.
+		d.Settings.PromptCredentialsOnce = false
+		d.MarkExplicit("PromptCredentialsOnce")
+	}
+	for key, v := range o.values {
+		switch key {
+		case "prompt_credentials":
+			d.Settings.PromptForCredentials = v == 1
+			d.MarkExplicit("PromptForCredentials")
+		case "fullscreen":
+			d.Settings.ScreenModeId = v + 1
+			d.MarkExplicit("ScreenModeId")
+		case "width":
+			d.Settings.DesktopWidth = v
+			d.MarkExplicit("DesktopWidth")
+		case "height":
+			d.Settings.DesktopHeight = v
+			d.MarkExplicit("DesktopHeight")
+		case "multimon":
+			d.Settings.UseMultimon = v == 1
+			d.MarkExplicit("UseMultimon")
+		case "clipboard":
+			d.Settings.RedirectClipboard = v == 1
+			d.MarkExplicit("RedirectClipboard")
+		case "drives":
+			d.Settings.DriveStoreRedirect = ""
+			if v == 1 {
+				d.Settings.DriveStoreRedirect = "*"
+			}
+			d.MarkExplicit("DriveStoreRedirect")
+		case "printers":
+			d.Settings.RedirectPrinters = v == 1
+			d.MarkExplicit("RedirectPrinters")
+		case "audiomode":
+			d.Settings.AudioMode = v
+			d.MarkExplicit("AudioMode")
+		}
+	}
+	return nil
+}
