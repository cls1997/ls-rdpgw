+	rr := httptest.NewRecorder()
+	h.HandleDownload(rr, authenticatedRequest("GET", "/connect?host=desktop%3A3390&credential_mode=custom&username=desktop-user&domain=CONTOSO&prompt_credentials=1&fullscreen=0&width=1280&height=720&multimon=0&clipboard=0&drives=0&printers=0&audiomode=0"))
+	if rr.Code != 200 {
+		t.Fatal(rr.Code, rr.Body.String())
+	}
+	data := rdpToMap(strings.Split(rr.Body.String(), rdp.CRLF))
+	expected := map[string]string{"username": "desktop-user", "domain": "CONTOSO", "gatewayaccesstoken": "oidc-user_desktop:3390", "full address": "desktop:3390", "gatewayhostname": "gateway.example", "prompt for credentials": "1", "promptcredentialonce": "0", "screen mode id": "1", "desktopwidth": "1280", "desktopheight": "720", "use multimon": "0", "redirectclipboard": "0", "drivestoredirect": "", "redirectprinters": "0", "audiomode": "0"}
+	for key, value := range expected {
+		if got, ok := data[key]; !ok || got != value {
+			t.Errorf("%s=%q present=%v want %q", key, got, ok, value)
